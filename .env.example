# Copy to .env — `make up` does this for you if .env is missing.

HTTP_ADDR=:8080

DATABASE_URL=postgres://docpipe:docpipe@localhost:5432/docpipe?sslmode=disable

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# Uploads are rejected above this. Enforced before anything is stored.
MAX_UPLOAD_BYTES=26214400

# Phase 1 has no auth. Every request is attributed to this seeded user;
# phase 2 replaces the middleware that injects it with real JWT parsing.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
